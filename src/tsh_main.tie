type tie<logic>
import "./repl.tie"
import "./command.tie"
import "./pipeline.tie"
import "./render.tie"
import "./backend_interp.tie"
import "./session.tie"
import "./lineedit.tie"
import "./complete.tie"
import "./run.tie"
// src/tsh_main.tie —— tshell 装配器最小实现（L4 宿主入口），默认全量装配
// --------------------------------------------------------------
// 独立 tshell（standalone = 默认全量装配）入口。装配 repl/command/pipeline/render
// （p.9.3.1）+ lineedit/complete/session（p.9.3.2）+ run 脚本运行时（p.9.3.3）。
// CLI 分派：无参 → 交互 REPL；-e expr → 单行；-f / 裸路径 → 脚本；--stdio → srv。
//
// EN: standalone shell entry (L4 host). Assembles p.9.3.1-3 modules. CLI dispatch:
// no-arg REPL, -e expr, -f/path script, --stdio protocol service.

func main() -> i64 {
    session.ss_load()
    var mode = run.rn_args()
    var m0 = mode[0]
    if m0 == "e" {
        var out = run.rn_eval_expr(mode[1])
        render.r_emit(out)
        return 0
    }
    if m0 == "f" {
        return run.rn_run_script(mode[1])
    }
    if m0 == "script" {
        return run.rn_run_script(mode[1])
    }
    if m0 == "stdio" {
        // p.9.3.4 srv 接管
        return 0
    }
    // interactive REPL
    println("tshell 0.1 (p.9.3.1-3: 核心+会话+脚本运行时)")
    while !command.ex_req() {
        print("tie> ")
        var line = read_line()
        var out = repl.repl_handle(line)
        session.ss_add(line)
        if out != "" {
            render.r_emit(out)
        } else if !command.ex_req() {
            render.r_emit_line("")
        }
    }
    session.ss_save()
    return 0
}