type tie<logic>
import "./repl.tie"
import "./command.tie"
import "./pipeline.tie"
import "./render.tie"
import "./backend_interp.tie"
import "./session.tie"
import "./lineedit.tie"
import "./complete.tie"
// src/tsh_main.tie —— tshell 装配器最小实现（L4 宿主入口），默认全量装配
// --------------------------------------------------------------
// 独立 tshell（standalone = 默认全量装配）入口。p.9.3.1 核心 + p.9.3.2 会话层
// （lineedit/complete/session：历史记录与会话持久化接线）。-e/-f/--stdio 由
// run/srv 子项接管。
//
// EN: standalone shell entry (L4 host). p.9.3.1 core + p.9.3.2 session wiring
// (history recording + persistence). -e/-f/--stdio handled by run/srv sub-items.

func main() -> i64 {
    session.ss_load()
    println("tshell 0.1 (p.9.3.1-2: repl/command/pipeline/render + lineedit/complete/session)")
    while !command.ex_req() {
        print("tie> ")
        var line = read_line()
        // EOF 时 read_line 内部退出（与 tiec repl 一致）
        var out = repl.repl_handle(line)
        session.ss_add(line)   // 空行/空白由 session 内部跳过
        if out != "" {
            render.r_emit(out)
        } else if !command.ex_req() {
            render.r_emit_line("")
        }
    }
    session.ss_save()
    return 0
}