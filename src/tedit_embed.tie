type tie<logic>
import "./lineedit.tie"
import "./complete.tie"
import "./command.tie"
import "./session.tie"
import "./render.tie"
// src/tedit_embed.tie —— tedit 终端模组嵌入子集装配示例（p.9.3.6）
// --------------------------------------------------------------
// 按架构 §12.4：tedit 终端模组取 lineedit + complete + command + session + render
//（+ repl 可选），**不装 observe / run 全量**。本文件演示最小的「会话层子集」装配
// —— 一个命令驱动的小宿主：会话加载、行编辑缓冲、补全候选、命令分派、会话保存。
// 仅依赖该五模块（command 因命令语义需 eval 而连带 backend_interp/observe/session）。
//
// EN: tedit terminal-module subset assembly example (§12.4): lineedit + complete
// + command + session + render. A command-driven minimal host demonstrating the
// session-layer subset (no repl/run/observe full).

func main() -> i64 {
    session.ss_load()
    println("[tedit_embed] 会话层子集装配：lineedit + complete + command + session + render")
    // 行编辑缓冲演示
    lineedit.le_reset()
    lineedit.le_insert("l")
    lineedit.le_insert("s")
    var buf = lineedit.le_get()
    println("缓冲区=" + buf)
    // 补全：对缓冲的 token 求候选
    var cands = complete.cpl_candidates(buf, 2)
    var hitLs = false
    for c in cands {
        if c == "ls" { hitLs = true }
    }
    println("补全命中 ls=" + hitLs_str(hitLs))
    // 命令分派：ls（内建）
    var line = "."
    var toks = sh_util_split("ls")
    var out = command.c_exec(toks)
    if out == "?" {
        println("[tedit_embed] 未知命令")
    } else {
        println("[tedit_embed] 命令输出首行如下（ls 当前目录）:")
        render.r_emit(out)
    }
    // 会话保存
    session.ss_save()
    println("[tedit_embed] 子集装配完成")
    return 0
}

func hitLs_str(b: bool) -> string {
    if b { return "true" }
    return "false"
}

func sh_util_split(s: string) -> table<string> {
    var out = table_new_string()
    table_push(out, s)
    return out
}