type tie<tsh>
// tests/jit_pipeline.tsh.tie —— p.9.17.4 第二步：单函数 JIT 管线验收
// ============================================================================
// 管线：fn_source(名) → 装配临时 unit → exec_code 调 tiec --shared →
//       load_library/get_proc → dyn_call_p 调用 → 与解释器结果逐项对拍。
// 用法（tshell 目录）：tsh_main.exe -f tests\jit_pipeline.tsh.tie
// 前置：环境变量 TIEC 指定 tiec.exe；缺省用 ..\tiec\compiler\tiec.exe。
// 产物：..\tiec\_tiec_verify\jit\（临时 unit/DLL/编译日志，不入库）。
// 退出码：0 = 全过 / 1 = 有 FAIL（对齐 tsh 测试惯例）。

var g_jfail: i64 = 0

func jchk(ok: bool, tag: string) {
    if ok {
        println("[PASS] " + tag)
    } else {
        println("[FAIL] " + tag)
        g_jfail = g_jfail + 1
    }
}

// ==================== 待 JIT 的函数（顶层定义 → 源码捕获） ====================

func jadd(a: i64, b: i64) -> i64 {
    return a + b
}

func jmul3(a: i64, b: i64, c: i64) -> i64 {
    return a * b * c
}

func jloop(n: i64) -> i64 {
    var s: i64 = 0
    var i: i64 = 1
    while i <= n {
        s = s + i * i
        i = i + 1
    }
    return s
}

func jbranch(a: i64) -> i64 {
    if a < 0 {
        return 0 - a
    }
    if a > 100 {
        return 100
    }
    return a * 2
}

// 回退负例：体内调用另一用户函数（临时单元里未定义 → 编译/加载失败）
func jcalls(a: i64) -> i64 {
    return jadd(a, 1)
}

// ==================== JIT 管线（脚本层粘合） ====================

func jit_try(name: string) -> i64 {
    var fs = fn_source(name)
    if str_len(fs) == 0 {
        println("[jit] " + name + ": no source captured")
        return 0
    }
    var dir = "..\\tiec\\_tiec_verify\\jit"
    mkdir_all(dir)
    var tie_path = dir + "\\" + name + ".unit.tie"
    var dll_path = dir + "\\" + name + ".unit.dll"
    file_write(tie_path, "type tie<class>\n" + fs + "\n")
    // 编译命令：cd /d 打头（cmd /c 对"引号开头命令"会剥离首尾引号的规则规避），
    // 工作目录切到 tiec 仓根；其后路径均相对 tiec 仓根。TIEC 环境变量可给绝对路径。
    var tiec = get_env("TIEC")
    if str_len(tiec) == 0 {
        tiec = "compiler\\tiec.exe"
    }
    var rc = exec_code("cd /d \"..\\tiec\" && \"" + tiec + "\" --shared \"_tiec_verify\\jit\\" + name + ".unit.tie\" -o \"_tiec_verify\\jit\\" + name + ".unit.dll\" --no-warn --no-cache > \"_tiec_verify\\jit\\" + name + ".build.log\" 2>&1")
    if rc != 0 {
        println("[jit] " + name + ": compile failed rc=" + to_string(rc) + " (fallback)")
        return 0
    }
    var h = load_library(dll_path)
    if h == 0 {
        println("[jit] " + name + ": load failed (fallback)")
        return 0
    }
    var addr = get_proc(h, name)
    if addr == 0 {
        println("[jit] " + name + ": symbol lookup failed (fallback)")
        return 0
    }
    return addr
}

// ==================== 对拍 ====================

println("== p.9.17.4 JIT pipeline probe ==")

// --- jadd ---
var a_add = jit_try("jadd")
if a_add != 0 {
    var j1 = dyn_call_p(a_add, 3, 4)
    jchk(jadd(3, 4) == j1 && j1 == 7, "jadd(3,4)=7 jit=" + to_string(j1))
    var j2 = dyn_call_p(a_add, 0 - 5, 5)
    jchk(jadd(0 - 5, 5) == j2 && j2 == 0, "jadd(-5,5)=0 jit=" + to_string(j2))
    var j3 = dyn_call_p(a_add, 900000000, 900000000)
    jchk(jadd(900000000, 900000000) == j3, "jadd(9e8,9e8) jit=" + to_string(j3))
} else {
    jchk(false, "jadd JIT available")
}

// --- jmul3 ---
var a_mul = jit_try("jmul3")
if a_mul != 0 {
    var m1 = dyn_call_p(a_mul, 6, 7, 8)
    jchk(jmul3(6, 7, 8) == m1 && m1 == 336, "jmul3(6,7,8)=336 jit=" + to_string(m1))
    var m2 = dyn_call_p(a_mul, 0 - 3, 0 - 4, 5)
    jchk(jmul3(0 - 3, 0 - 4, 5) == m2 && m2 == 60, "jmul3(-3,-4,5)=60 jit=" + to_string(m2))
} else {
    jchk(false, "jmul3 JIT available")
}

// --- jloop ---
var a_loop = jit_try("jloop")
if a_loop != 0 {
    var l1 = dyn_call_p(a_loop, 10)
    jchk(jloop(10) == l1 && l1 == 385, "jloop(10)=385 jit=" + to_string(l1))
    var l2 = dyn_call_p(a_loop, 0)
    jchk(jloop(0) == l2 && l2 == 0, "jloop(0)=0 jit=" + to_string(l2))
} else {
    jchk(false, "jloop JIT available")
}

// --- jbranch ---
var a_br = jit_try("jbranch")
if a_br != 0 {
    var b1 = dyn_call_p(a_br, 0 - 7)
    jchk(jbranch(0 - 7) == b1 && b1 == 7, "jbranch(-7)=7 jit=" + to_string(b1))
    var b2 = dyn_call_p(a_br, 40)
    jchk(jbranch(40) == b2 && b2 == 80, "jbranch(40)=80 jit=" + to_string(b2))
    var b3 = dyn_call_p(a_br, 500)
    jchk(jbranch(500) == b3 && b3 == 100, "jbranch(500)=100 jit=" + to_string(b3))
} else {
    jchk(false, "jbranch JIT available")
}

// --- 回退负例：jcalls 体内调 jadd（临时单元未定义）→ 应不可 JIT ---
var a_calls = jit_try("jcalls")
jchk(a_calls == 0, "jcalls not-jittable (fallback)")
jchk(jcalls(6) == 7, "jcalls interp=7")

// --- 未定义函数名查询 ---
jchk(str_len(fn_source("no_such_fn_xyz")) == 0, "fn_source missing -> empty")

if g_jfail == 0 {
    println("ALL:PASS")
    exit(0)
}
println("ALL:FAIL " + to_string(g_jfail))
exit(1)
