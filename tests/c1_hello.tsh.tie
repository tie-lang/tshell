type tie<tsh>
// c1_hello.tsh.tie —— 任务 p.9.13.8-C1 最小 run 角色冒烟：println + 变量 + for/表 + 文件操作。
// 验证 tsh 本机 -f 可跑（不新建/修改 .ps1，纯 tsh 语义）。
println("hello from tsh c1")
var base = 21
var doubled = base * 2
println("doubled=" + to_string(doubled))
var t = table_new_string()
for i in 0..5 {
    table_push(t, "item-" + to_string(i))
}
println("tlen=" + to_string(len(t)))
// 文件操作：写 + 读回
var tmp = get_env("TEMP")
var f = path_join(tmp, "c1_hello_out.txt")
var w = file_write(f, "c1-content")
var r = file_read(f)
println("fread=" + r)
if file_exists(f) { println("file_exists=yes") } else { println("file_exists=no") }
exit(0)