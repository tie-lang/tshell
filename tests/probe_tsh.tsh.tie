type tie<tsh>
// probe_tsh.tsh.tie —— tsh 角色探针（shell 角色基础设施，p.9.4；整文件脚本语义版）
// --------------------------------------------------------------
// p.9.4 由旧探针迁移为整文件脚本语义（rn_run_script → interp.eval_script：
// 跨行函数、多行块、exit(n) 表达式内建）。tiec 据 `.tsh.tie` 扩展名 + `type tie<tsh>`
// 头部识别 tsh 角色，推荐并由 tie 自己的 tshell 运行（driver 经 exec_code 调 tshell -f）。
// 本探针练习：tie 表达式/环境变量/外部命令/目录枚举 + 显式退出码（新契约 exit(n)）。
//
// EN: tsh-role probe (whole-file script semantics, p.9.4). tiec routes .tsh.tie to
// tshell; this probe exercises tie exprs, env, external cmd, directory enumeration
// and the conditional exit(n) expression form.
// RUN: tshell\src\tsh_main.exe -f tshell\tests\probe_tsh.tsh.tie
// echo $LASTEXITCODE   # expect 7

// 1) tie 表达式（整文件求值）
var left = 6 * 7
var top = "tsh"
println("tie-expr: " + top + " n=" + to_string(left))

// 2) 环境变量读取（interp 内建 get_env）
var hv = get_env("TIE_PROBE_VAR")
println("env TIE_PROBE_VAR=" + hv)

// 3) 外部命令 stdout 捕获 + 退出码（interp 内建 exec_output / exec_code）
var who = exec_output("cmd /c echo external-ok")
println("external=" + who)
var rc_ext = exec_code("exit /b 0")
println("exec_code exit=" + to_string(rc_ext))

// 4) 目录枚举（interp 内建 list_dir）
var n_ents: i64 = 0
var ents = list_dir(".")
for e in ents {
    n_ents = n_ents + 1
}
println("list_dir count=" + to_string(n_ents))

// 5) 显式退出码（新契约：exit(n) 表达式内建 → tshell 进程退出码透传）
exit(7)